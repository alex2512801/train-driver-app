<?xml version="1.0" encoding="utf-8"?>
<!--
    Временный технический экран. Настоящий главный экран (значки сигналов/станций,
    пиктограммы, профиль рельефа и т.д. — см. ТЗ, раздел 7 и раздел 14 с макетами) будет
    достраиваться отдельными шагами. TrackProfileView ниже — километровая линейка и
    ступенчатый график ограничений скорости, сверено с макетом, но ещё не проверено на
    реальном устройстве.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/coordinateText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/waiting_for_gps"
            android:textColor="#FFFFFF"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/timeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/directionInfoText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#AAAAAA"
        android:textSize="14sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp">

        <ru.traindriver.app.ui.TrackProfileView
            android:id="@+id/trackProfileView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Окошко прибытия/отправления (ТЗ раздел 10) — не отдельный экран, сидит поверх
             графика (график остаётся видимым/активным вокруг), фон непрозрачный для контраста.
             Показывается/скрывается через arrivalToggleButton, gone по умолчанию (состояние
             Hidden — едем, стоянок ещё не было). -->
        <LinearLayout
            android:id="@+id/arrivalWindow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:orientation="vertical"
            android:background="#FF000000"
            android:padding="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/arrivalTimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/arrivalMidText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/arrivalDepartureText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:fontFamily="monospace" />

        </LinearLayout>

        <!-- История остановок (ТЗ раздел 10) — отдельная компактная полупрозрачная панель,
             справа, тоже поверх графика. Каждая остановка — одна строка: место | приб | отпр |
             время стоянки. Не модалка — та же логика, что у arrivalWindow выше. -->
        <LinearLayout
            android:id="@+id/stopHistoryPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:orientation="vertical"
            android:background="#CC1A1A1A"
            android:padding="6dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="История остановок"
                android:textAllCaps="true"
                android:textColor="#999999"
                android:textSize="10sp" />

            <LinearLayout
                android:id="@+id/stopHistoryRows"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </FrameLayout>

    <TextView
        android:id="@+id/statusBarText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:fontFamily="monospace" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/directionButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Чётное" />

        <Button
            android:id="@+id/pathButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Путь 2" />

        <Button
            android:id="@+id/paramsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Параметры" />

        <Button
            android:id="@+id/arrivalToggleButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Стоянка ⏱" />

        <Button
            android:id="@+id/historyToggleButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="История" />

        <Button
            android:id="@+id/restrictionsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Ограничения" />

    </LinearLayout>

</LinearLayout>
