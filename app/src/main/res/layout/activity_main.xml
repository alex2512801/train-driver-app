<?xml version="1.0" encoding="utf-8"?>
<!--
    Главный экран (ТЗ раздел 7, сверено с HTML-макетом "Ступени Хилока" — шапка там же,
    .phone-header). Шапка — ОДНА строка (машинист поправил: была в две, он хочет одну —
    все элементы помещаются сразу, без прокрутки вбок, но компактнее по размеру, чем
    раньше — см. HeaderToggleButton/HeaderIconButton в themes.xml). Слева направо:
    км+пк | станция назначения (следующая по ходу, не конечная) | Чётное/Нечётное | Путь |
    К1 | ⏱ окошко стоянки | 📋 история | ⚠ ограничения (настоящий чёрно-белый знак "начало
    опасного места", OpasnoeIconView) | день/ночь | уровень сигнала SIM-карт — ДО ДВУХ слотов
    (SignalBarsView + тип сети каждый, машинист попросил видеть обе свои SIM) | МСК/местное
    время (специально в конце).
    "Параметры" переехали вниз, в правый конец статусной строки под графиком (машинист:
    "чтобы она там не мешалась") — см. комментарий у statusBarRow ниже.
    Экран открывается развёрнуто на весь экран, системная строка состояния телефона скрыта
    программно (MainActivity.hideSystemUi) — поэтому своя собственная шапка и показывает
    время и сигнал SIM, как раньше показывала системная.
    "Меню" (ТЗ раздел 12, со всеми подразделами) и заряд батареи из макета сюда ЕЩЁ НЕ
    добавлены — это отдельный, пока не сделанный шаг (см. README/чат). К1 (переключатель
    сигналов среднего пути Тургутуй — Яблоновая) добавлен только как кнопка — сама логика
    переключения путей для него ещё не реализована (см. README), поэтому пока только
    показывает короткое сообщение по нажатию.

    Пропорции по высоте — изначально машинист продиктовал по измерению на экране (шапка 1,3 |
    график, из него скорости+сигналы 7,5 и рельеф 3 | нижняя строка 3,7 — веса LinearLayout
    13:105:37), но в шапку с весом 13 кнопки/иконки/время физически не влезали (показывались
    пустыми рамками без текста) — машинист поправил: забрать примерно половину веса у нижней
    строки и отдать шапке. Сейчас: шапка 32 | график 105 (внутри — то же отношение 7,5:3 =
    STEPS_TO_RELIEF_RATIO в TrackProfileView, не менялось) | нижняя строка 18.
    directionInfoText (диагностическая строка "путь правильный, датасет..." под шапкой) —
    машинист попросил убрать как лишнюю информацию, удалена целиком (и из разметки, и из
    MainActivity).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <!-- Вес 32 — машинист поправил продиктованную пропорцию (13:105:37): в шапку с весом 13
         кнопки/иконки/время физически не влезали (показывались пустыми рамками без текста,
         машинист прислал скриншот) — он попросил забрать примерно половину веса у нижней
         строки (37→18) и отдать шапке (13→32), см. её doc-комментарий ниже. Без
         HorizontalScrollView (как раньше) — машинист попросил прижать SIM+время к правому
         краю экрана через гибкий разделитель (см. simHeaderSpacer ниже), а это работает
         только когда сама строка на всю ширину экрана, не wrap_content внутри скролла. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="32"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

            <!-- 1. Координата км+пк — по тапу переключается в формат КЛУБ-У. -->
            <TextView
                android:id="@+id/coordinateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/waiting_for_gps"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:textSize="18sp"
                android:paddingEnd="6dp" />

            <View style="@style/HeaderDivider" />

            <!-- 2. Станция назначения — следующая по ходу движения, не конечная станция всего
                 маршрута (обновляется и при смене направления/пути, и на каждой GPS-позиции,
                 см. updateDestinationText). -->
            <TextView
                android:id="@+id/destinationText"
                android:layout_width="95dp"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textColor="#DDDDDD"
                android:textSize="13sp"
                android:maxLines="2" />

            <View style="@style/HeaderDivider" />

            <!-- 3. Чётное/Нечётное направление. -->
            <Button
                android:id="@+id/directionButton"
                style="@style/HeaderToggleButton"
                android:text="Чётное" />

            <!-- 4. Путь 1/2. -->
            <Button
                android:id="@+id/pathButton"
                style="@style/HeaderToggleButton"
                android:layout_marginStart="4dp"
                android:text="Путь 2" />

            <!-- 5. К1 — сигналы среднего пути Тургутуй—Яблоновая/Карымская (см. doc-комментарий
                 выше: пока без настоящей логики переключения). -->
            <Button
                android:id="@+id/k1Button"
                style="@style/HeaderToggleButton"
                android:layout_marginStart="4dp"
                android:text="К1" />

            <View style="@style/HeaderDivider" />

            <!-- 6/7. Окошко стоянки и история остановок (ТЗ раздел 10) — иконки-кнопки. -->
            <Button
                android:id="@+id/arrivalToggleButton"
                style="@style/HeaderIconButton"
                android:text="⏱" />

            <Button
                android:id="@+id/historyToggleButton"
                style="@style/HeaderIconButton"
                android:layout_marginStart="2dp"
                android:text="📋" />

            <View style="@style/HeaderDivider" />

            <!-- 8. Ограничения (ТЗ раздел 11) — настоящий чёрно-белый знак "начало опасного
                 места" (ГОСТ, тот же чертёж, что и пиктограмма на графике), не текст/эмодзи,
                 без жёлтого/цветного фона (машинист поправил) — см. OpasnoeIconView. -->
            <ru.traindriver.app.ui.OpasnoeIconView
                android:id="@+id/restrictionsButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <View style="@style/HeaderDivider" />

            <!-- 9. День/ночь. -->
            <Button
                android:id="@+id/dayNightButton"
                style="@style/HeaderIconButton"
                android:text="🌙" />

            <View style="@style/HeaderDivider" />

            <!-- Гибкий разделитель — прижимает SIM+время (см. ниже) к правому краю экрана
                 (машинист: "чтобы они были ближе к правой части экрана"). Работает только
                 потому, что сама строка шапки теперь во всю ширину экрана (см. комментарий
                 у неё выше), а не wrap_content внутри HorizontalScrollView — иначе у веса
                 нет "лишнего" места, которое можно забрать. -->
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <!-- 10. Уровень сигнала SIM-карт + тип сети (ТЗ раздел 7, HTML-макет .hdr-sim) —
                 своя замена системной строке состояния, которую мы теперь скрываем (см.
                 MainActivity.hideSystemUi). На месте "Параметры" (машинист попросил: она
                 переехала вниз в статусную строку, см. ниже) — ДВА слота, по одному на
                 каждую SIM-карту (у машиниста их две и обе должны быть видны); второй слот
                 скрыт (visibility=gone), пока MainActivity не обнаружит вторую активную SIM. -->
            <LinearLayout
                android:id="@+id/simSlot0Group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ru.traindriver.app.ui.SignalBarsView
                    android:id="@+id/simSlot0Bars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/simSlot0Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:text="—" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/simSlot1Group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="6dp"
                android:visibility="gone">

                <ru.traindriver.app.ui.SignalBarsView
                    android:id="@+id/simSlot1Bars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/simSlot1Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:text="—" />

            </LinearLayout>

            <View style="@style/HeaderDivider" />

            <!-- 11. Время — МСК (всегда) и местное (часовой пояс телефона), друг под другом,
                 специально в самом конце шапки (машинист попросил перенести его туда) —
                 выровнено по ПРАВОМУ краю (gravity=end), не по левому: машинист поправил —
                 раньше обе строки начинались с одного места слева ("МСК"/"Мест" — разная
                 длина слова), из-за чего сами цифры времени не совпадали по вертикали;
                 gravity=end выравнивает по последним символам (по секундам), так как они
                 обе заканчиваются в одном и том же месте — у правого края TextView. -->
            <TextView
                android:id="@+id/timeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:paddingEnd="6dp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:lineSpacingExtra="1dp" />

        </LinearLayout>

    <!-- Вес 105 (= 75 скорости+сигналы + 30 рельеф — см. doc-комментарий класса) — сам график
         внутри делит эту высоту в том же отношении 7,5:3 через STEPS_TO_RELIEF_RATIO
         (TrackProfileView). Раньше под шапкой была ещё diagnostic-строка directionInfoText
         ("путь правильный, датасет...") — машинист попросил убрать как лишнюю информацию;
         освободившееся место ушло графику (он и так самый большой вес, 105 из 155). -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="105"
        android:layout_marginTop="4dp">

        <ru.traindriver.app.ui.TrackProfileView
            android:id="@+id/trackProfileView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Окошко прибытия/отправления (ТЗ раздел 10) — не отдельный экран, сидит поверх
             графика (график остаётся видимым/активным вокруг), фон непрозрачный для контраста.
             Показывается/скрывается через arrivalToggleButton, gone по умолчанию (состояние
             Hidden — едем, стоянок ещё не было). -->
        <LinearLayout
            android:id="@+id/arrivalWindow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:orientation="vertical"
            android:background="#FF000000"
            android:padding="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/arrivalTimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/arrivalMidText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/arrivalDepartureText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="monospace" />

        </LinearLayout>

        <!-- История остановок (ТЗ раздел 10) — отдельная компактная полупрозрачная панель,
             справа, тоже поверх графика. Каждая остановка — одна строка: место | приб | отпр |
             время стоянки. Не модалка — та же логика, что у arrivalWindow выше. -->
        <LinearLayout
            android:id="@+id/stopHistoryPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:orientation="vertical"
            android:background="#CC1A1A1A"
            android:padding="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="История остановок"
                android:textAllCaps="true"
                android:textColor="#999999"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/stopHistoryRows"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </FrameLayout>

    <!-- Нижняя статусная строка (ТЗ раздел 7): Vф/Уклон/V=.../S=.../Голова/Хвост слева,
         "Параметры" машинист попросил перенести СЮДА, в правый конец этой же строки, "чтобы
         она там не мешалась" в шапке сверху. Вес 18 — машинист поправил: было слишком много
         пустого места под одну строку текста, попросил забрать примерно половину веса
         (37→18) у этой строки и отдать шапке (13→32) выше. -->
    <LinearLayout
        android:id="@+id/statusBarRow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="18"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1A1A1A">

        <TextView
            android:id="@+id/statusBarText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="20sp"
            android:letterSpacing="0.02"
            android:fontFamily="monospace"
            android:text="Vф=? Уклон=? V=? S=? Голова=? Хвост=?" />

        <!-- Параметры состава (ТЗ раздел 12.2) — временно прямой кнопкой, см. doc-комментарий
             класса выше про "Меню". -->
        <Button
            android:id="@+id/paramsButton"
            style="@style/HeaderToggleButton"
            android:layout_marginEnd="8dp"
            android:text="Параметры" />

    </LinearLayout>

</LinearLayout>
