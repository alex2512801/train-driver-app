<?xml version="1.0" encoding="utf-8"?>
<!--
    "Ограничения" (ТЗ раздел 11, машинист называет их "предупреждения") — ОТДЕЛЬНЫЙ
    полноэкранный экран (RestrictionsActivity), не диалог/Dialog поверх главного — у обычной
    Activity никакой "плавающей" логики размера окна нет в принципе, экран гарантированно на
    весь физический размер устройства.

    Поля теперь не открывают системную клавиатуру — это выключается кодом,
    setShowSoftInputOnFocus(false) в RestrictionsActivity.onCreate (атрибут
    android:showSoftInputOnFocus в самой разметке не существует как публичный XML-атрибут, хоть
    метод и называется так же — AAPT ругается "attribute not found", если его тут написать), и
    дополнительно явным запретом на уровне самого окна (Window.setSoftInputMode). Ввод идёт
    через свою маленькую цифровую клавиатуру (1-9, ←/0/→, Стереть), а ← → явно и однозначно
    переключают активное поле строго по порядку км→пк→км→пк→скорость→путь (оно подсвечивается
    синим) — порядок заранее известный и правильный, гадать не на что.

    ДВЕ КОЛОНКИ, как телефонный набор номера (машинист сам так и описал) — слева поля ввода и
    список уже введённых ограничений друг под другом, справа ОТДЕЛЬНОЙ колонкой клавиатура на
    ВСЮ высоту экрана:
      - до этого было: единый вертикальный список (поля → список → клавиатура), где поля+список
        и клавиатура делили одну и ту же высоту через layout_weight — но стоило списку
        ограничений подрасти (несколько записей), он отнимал высоту у клавиатуры, и клавиатура
        сжималась почти до нуля/пропадала. Та же беда была раньше и с двумя колонками первой
        версии, где клавиатура была СНИЗУ под полями в левой колонке — поля тоже могли отнять
        у неё место.
      - теперь клавиатура — это вся правая колонка целиком, её высота НИКАК не зависит от того,
        сколько места заняли поля или список в левой колонке (это независимые соседние колонки
        одного ряда, а не блоки один под другим) — клавиатура гарантированно получает свою долю
        высоты экрана целиком, что бы ни происходило слева.
      - левая колонка: поля (wrap_content, три строки — Начало, Конец, Скорость+Путь), кнопка
        "Добавить" сразу под ними, затем список ограничений — он один занимает ВЕСЬ остаток
        высоты левой колонки (layout_weight) и прокручивается сам при необходимости (прокрутка
        для списка — это нормально и ожидаемо, в отличие от клавиатуры, которой прокрутка
        категорически не подходит, см. всю историю этого экрана).

    Кнопки клавиатуры — RestrictionKeypadButton, с явным parent="Widget.AppCompat.Button.Borderless"
    (см. themes.xml) — без этого обычный <Button> под темой Theme.MaterialComponents превращается
    в MaterialButton со своим полупрозрачным слоем поверх текста, из-за которого белые цифры были
    почти не видны.

    Список ограничений общий с MainActivity через RestrictionsStore (route/Restriction.kt) —
    простой общий объект в памяти, а не Intent-данные: он и так живёт только в памяти на время
    сессии в обоих случаях. MainActivity обновляет график (TrackProfileView.setRestrictions) в
    своём onResume(), когда возвращается с этого экрана.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#333333"
        android:padding="16dp"
        android:text="Ограничения"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Вес 1 — вся оставшаяся высота (между шапкой и кнопкой "Закрыть") ЧЁТКО задана, не
         wrap_content — от неё отталкиваются обе колонки ниже (см. doc-комментарий выше). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Левая колонка: поля, кнопка "Добавить", список — друг под другом. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:orientation="vertical"
            android:paddingEnd="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="НАЧАЛО"
                    android:textColor="#5AAADC"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/restrictionStartKmInput"
                    style="@style/RestrictionDigitBox"
                    android:layout_width="56dp"
                    android:hint="км"
                    android:inputType="number"
                    android:maxLength="4" />

                <EditText
                    android:id="@+id/restrictionStartPkInput"
                    style="@style/RestrictionDigitBox"
                    android:layout_width="40dp"
                    android:layout_marginStart="6dp"
                    android:hint="пк"
                    android:inputType="number"
                    android:maxLength="2" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="КОНЕЦ"
                    android:textColor="#5AAADC"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/restrictionEndKmInput"
                    style="@style/RestrictionDigitBox"
                    android:layout_width="56dp"
                    android:hint="км"
                    android:inputType="number"
                    android:maxLength="4" />

                <EditText
                    android:id="@+id/restrictionEndPkInput"
                    style="@style/RestrictionDigitBox"
                    android:layout_width="40dp"
                    android:layout_marginStart="6dp"
                    android:hint="пк"
                    android:inputType="number"
                    android:maxLength="2" />

            </LinearLayout>

            <!-- Сначала скорость, потом путь (машинист: пустой путь = текущее направление, это
                 основной случай, поэтому скорость логичнее вводить первой). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="СКОРОСТЬ"
                    android:textColor="#5AAADC"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/restrictionSpeedInput"
                    style="@style/RestrictionDigitBox"
                    android:layout_width="44dp"
                    android:hint="—"
                    android:inputType="number"
                    android:maxLength="2" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:text="ПУТЬ"
                    android:textColor="#5AAADC"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/restrictionPathInput"
                    style="@style/RestrictionDigitBox"
                    android:layout_width="36dp"
                    android:layout_marginStart="10dp"
                    android:hint="—"
                    android:inputType="number"
                    android:maxLength="1" />

            </LinearLayout>

            <TextView
                android:id="@+id/restrictionErrorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#E05A5A"
                android:visibility="gone" />

            <Button
                android:id="@+id/restrictionAddButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Добавить" />

            <!-- Список — один занимает весь остаток высоты ЛЕВОЙ колонки (не экрана целиком),
                 правой колонки с клавиатурой это не касается вообще. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="СПИСОК ОГРАНИЧЕНИЙ"
                    android:textColor="#5AAADC"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:id="@+id/restrictionRowsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </ScrollView>

            </LinearLayout>

        </LinearLayout>

        <!-- Правая колонка: ТОЛЬКО клавиатура, на всю высоту (match_parent) — её размер не
             зависит от того, сколько места заняло слева (см. doc-комментарий выше). Шире левой
             (weight 3 против 2) — машинист попросил, чтобы кнопки были крупными и хорошо видны,
             как при наборе номера на телефоне. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:orientation="vertical"
            android:paddingStart="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <Button android:id="@+id/restrictionKey1" style="@style/RestrictionKeypadButton" android:layout_height="match_parent" android:text="1" />
                <Button android:id="@+id/restrictionKey2" style="@style/RestrictionKeypadButton" android:layout_height="match_parent" android:text="2" />
                <Button android:id="@+id/restrictionKey3" style="@style/RestrictionKeypadButton" android:layout_height="match_parent" android:text="3" />
                <Button android:id="@+id/restrictionKey4" style="@style/RestrictionKeypadButton" android:layout_height="match_parent" android:text="4" />
                <Button android:id="@+id/restrictionKey5" style="@style/RestrictionKeypadButton" android:layout_height="match_parent" android:text="5" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <Button android:id="@+id/restrictionKey6" style="@style/RestrictionKeypadButton" android:layout_height="match_parent" android:text="6" />
                <Button android:id="@+id/restrictionKey7" style="@style/RestrictionKeypadButton" android:layout_height="match_parent" android:text="7" />
                <Button android:id="@+id/restrictionKey8" style="@style/RestrictionKeypadButton" android:layout_height="match_parent" android:text="8" />
                <Button android:id="@+id/restrictionKey9" style="@style/RestrictionKeypadButton" android:layout_height="match_parent" android:text="9" />
                <Button android:id="@+id/restrictionKey0" style="@style/RestrictionKeypadButton" android:layout_height="match_parent" android:text="0" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <Button android:id="@+id/restrictionKeyPrev" style="@style/RestrictionKeypadButton" android:layout_height="match_parent" android:text="←" />
                <Button
                    android:id="@+id/restrictionBackspaceButton"
                    style="@style/RestrictionKeypadButton"
                    android:layout_height="match_parent"
                    android:layout_weight="3"
                    android:text="Стереть" />
                <Button android:id="@+id/restrictionKeyNext" style="@style/RestrictionKeypadButton" android:layout_height="match_parent" android:text="→" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#333333"
        android:gravity="end"
        android:padding="12dp">

        <Button
            android:id="@+id/restrictionCloseButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:textColor="#B39DDB"
            android:textStyle="bold"
            android:text="ЗАКРЫТЬ" />

    </LinearLayout>

</LinearLayout>
