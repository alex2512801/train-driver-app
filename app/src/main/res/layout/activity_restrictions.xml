<?xml version="1.0" encoding="utf-8"?>
<!--
    "Ограничения" (ТЗ раздел 11, машинист называет их "предупреждения") — ОТДЕЛЬНЫЙ
    полноэкранный экран (RestrictionsActivity), не диалог/Dialog поверх главного — у обычной
    Activity никакой "плавающей" логики размера окна нет в принципе, экран гарантированно на
    весь физический размер устройства.

    Поля теперь не открывают системную клавиатуру — это выключается кодом,
    setShowSoftInputOnFocus(false) в RestrictionsActivity.onCreate (атрибут
    android:showSoftInputOnFocus в самой разметке не существует как публичный XML-атрибут, хоть
    метод и называется так же — AAPT ругается "attribute not found", если его тут написать), и
    дополнительно явным запретом на уровне самого окна (Window.setSoftInputMode). Ввод идёт
    через свою маленькую цифровую клавиатуру (1-9, ←/0/→, Стереть, Добавить), а ← → явно и
    однозначно переключают активное поле строго по порядку км→пк→км→пк→скорость→путь (оно
    подсвечивается синим) — порядок заранее известный и правильный, гадать не на что.

    ТРИ КОЛОНКИ (машинист попросил именно так): слева поля ввода, посередине список уже
    введённых ограничений, справа отдельной колонкой клавиатура на всю высоту экрана — кнопка
    "Добавить" теперь тоже на клавиатуре, отдельной строкой снизу (как кнопка вызова на
    телефонном наборе номера), а не отдельной кнопкой под полями.

    Почему именно три независимые колонки, а не один блок за другим по вертикали: раньше поля,
    список и клавиатура делили одну и ту же высоту (друг под другом) — стоило списку
    ограничений подрасти на несколько записей, клавиатуре переставало хватать места, и она
    сжималась до нуля/пропадала. Колонки одного ряда друг от друга в этом смысле НЕ зависят:
    у каждой высота — match_parent, то есть вся доступная высота экрана целиком, независимо от
    того, сколько содержимого в соседних колонках. Список ограничений (средняя колонка)
    прокручивается сам при необходимости — это нормально для списка, в отличие от клавиатуры,
    которой прокрутка категорически не подходит (см. всю историю этого экрана).

    Сама клавиатура — классический телефонный номеронабор (машинист попросил именно так):
    1-2-3 / 4-5-6 / 7-8-9 сверху вниз, затем ←, 0, → одной строкой, и Стереть с Добавить пополам
    делят последнюю строку. Шапка "Ограничения" сверху — пониже, чем раньше (padding 8dp вместо
    16dp, текст 16sp вместо 18sp): машинист попросил не отдавать ей лишнее место.

    Кнопки клавиатуры — RestrictionKeypadButton, с явным parent="Widget.AppCompat.Button.Borderless"
    (см. themes.xml) — без этого обычный <Button> под темой Theme.MaterialComponents превращается
    в MaterialButton со своим полупрозрачным слоем поверх текста, из-за которого белые цифры были
    почти не видны.

    Список ограничений общий с MainActivity через RestrictionsStore (route/Restriction.kt) —
    простой общий объект в памяти, а не Intent-данные: он и так живёт только в памяти на время
    сессии в обоих случаях. MainActivity обновляет график (TrackProfileView.setRestrictions) в
    своём onResume(), когда возвращается с этого экрана.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- Пониже, чем было — машинист попросил не отдавать шапке лишнее место, которое нужнее
         клавиатуре и полям. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#333333"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="Ограничения"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Вес 1 — вся оставшаяся высота (между шапкой и кнопкой "Закрыть") ЧЁТКО задана, не
         wrap_content — от неё отталкиваются все три колонки ниже (см. doc-комментарий выше). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Колонка 1: поля ввода. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:orientation="vertical"
            android:paddingEnd="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="НАЧАЛО"
                    android:textColor="#5AAADC"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/restrictionStartKmInput"
                    style="@style/RestrictionDigitBox"
                    android:layout_width="56dp"
                    android:hint="км"
                    android:inputType="number"
                    android:maxLength="4" />

                <EditText
                    android:id="@+id/restrictionStartPkInput"
                    style="@style/RestrictionDigitBox"
                    android:layout_width="40dp"
                    android:layout_marginStart="6dp"
                    android:hint="пк"
                    android:inputType="number"
                    android:maxLength="2" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="КОНЕЦ"
                    android:textColor="#5AAADC"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/restrictionEndKmInput"
                    style="@style/RestrictionDigitBox"
                    android:layout_width="56dp"
                    android:hint="км"
                    android:inputType="number"
                    android:maxLength="4" />

                <EditText
                    android:id="@+id/restrictionEndPkInput"
                    style="@style/RestrictionDigitBox"
                    android:layout_width="40dp"
                    android:layout_marginStart="6dp"
                    android:hint="пк"
                    android:inputType="number"
                    android:maxLength="2" />

            </LinearLayout>

            <!-- Сначала скорость, потом путь (машинист: пустой путь = текущее направление, это
                 основной случай, поэтому скорость логичнее вводить первой). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="СКОРОСТЬ"
                    android:textColor="#5AAADC"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/restrictionSpeedInput"
                    style="@style/RestrictionDigitBox"
                    android:layout_width="44dp"
                    android:hint="—"
                    android:inputType="number"
                    android:maxLength="2" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="ПУТЬ"
                    android:textColor="#5AAADC"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/restrictionPathInput"
                    style="@style/RestrictionDigitBox"
                    android:layout_width="36dp"
                    android:hint="—"
                    android:inputType="number"
                    android:maxLength="1" />

            </LinearLayout>

            <TextView
                android:id="@+id/restrictionErrorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#E05A5A"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Колонка 2: список уже введённых ограничений, на всю высоту, сам прокручивается. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="СПИСОК ОГРАНИЧЕНИЙ"
                android:textColor="#5AAADC"
                android:textSize="12sp"
                android:layout_marginBottom="6dp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/restrictionRowsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </ScrollView>

        </LinearLayout>

        <!-- Колонка 3: ТОЛЬКО клавиатура — её размер не зависит от того, сколько места заняло
             слева или посередине (см. doc-комментарий выше). "Добавить" — тоже клавиша клавиатуры,
             отдельной строкой снизу (как кнопка вызова на телефонном наборе номера). -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:orientation="vertical">

            <!-- Классический телефонный набор номера (машинист попросил именно так): 1-2-3,
                 4-5-6, 7-8-9, слева/справа от 0 — переключение активного поля (← →), а внизу
                 Стереть и Добавить пополам делят последнюю строку. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <Button android:id="@+id/restrictionKey1" style="@style/RestrictionKeypadButton" android:layout_height="match_parent" android:text="1" />
                <Button android:id="@+id/restrictionKey2" style="@style/RestrictionKeypadButton" android:layout_height="match_parent" android:text="2" />
                <Button android:id="@+id/restrictionKey3" style="@style/RestrictionKeypadButton" android:layout_height="match_parent" android:text="3" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <Button android:id="@+id/restrictionKey4" style="@style/RestrictionKeypadButton" android:layout_height="match_parent" android:text="4" />
                <Button android:id="@+id/restrictionKey5" style="@style/RestrictionKeypadButton" android:layout_height="match_parent" android:text="5" />
                <Button android:id="@+id/restrictionKey6" style="@style/RestrictionKeypadButton" android:layout_height="match_parent" android:text="6" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <Button android:id="@+id/restrictionKey7" style="@style/RestrictionKeypadButton" android:layout_height="match_parent" android:text="7" />
                <Button android:id="@+id/restrictionKey8" style="@style/RestrictionKeypadButton" android:layout_height="match_parent" android:text="8" />
                <Button android:id="@+id/restrictionKey9" style="@style/RestrictionKeypadButton" android:layout_height="match_parent" android:text="9" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <Button android:id="@+id/restrictionKeyPrev" style="@style/RestrictionKeypadButton" android:layout_height="match_parent" android:text="←" />
                <Button android:id="@+id/restrictionKey0" style="@style/RestrictionKeypadButton" android:layout_height="match_parent" android:text="0" />
                <Button android:id="@+id/restrictionKeyNext" style="@style/RestrictionKeypadButton" android:layout_height="match_parent" android:text="→" />
            </LinearLayout>

            <!-- Стереть и Добавить пополам делят последнюю строку (машинист). "Добавить" —
                 обычный (не RestrictionKeypadButton) стиль кнопки, чтобы явно выделяться среди
                 цифр как кнопка подтверждения, как кнопка вызова на телефоне. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="3dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/restrictionBackspaceButton"
                    style="@style/RestrictionKeypadButton"
                    android:layout_height="match_parent"
                    android:text="Стереть" />
                <Button
                    android:id="@+id/restrictionAddButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="3dp"
                    android:text="Добавить" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#333333"
        android:gravity="end"
        android:padding="12dp">

        <Button
            android:id="@+id/restrictionCloseButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:textColor="#B39DDB"
            android:textStyle="bold"
            android:text="ЗАКРЫТЬ" />

    </LinearLayout>

</LinearLayout>
