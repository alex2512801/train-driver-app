<?xml version="1.0" encoding="utf-8"?>
<!--
    "Ограничения" (ТЗ раздел 11, машинист называет их "предупреждения") — ОТДЕЛЬНЫЙ
    полноэкранный экран (RestrictionsActivity), не диалог/Dialog поверх главного. Раньше это
    был диалог поверх главного экрана — сначала AlertDialog, потом полноэкранный Dialog — но
    ни один вариант так и не удалось сделать надёжно прокручиваемым на невысоком альбомном
    экране: AlertDialog сам решает, какая высота нужна его содержимому (wrap_content), и
    ScrollView с такой же wrap_content высотой внутри него никогда не включает прокрутку
    по-настоящему; у "полноэкранного" Dialog (тема Theme_..._Fullscreen) само слово
    "Fullscreen" тоже оказалось обманчивым — оно только прячет системную строку состояния,
    а не растягивает окно диалога на весь экран, и даже принудительный
    Dialog.window.setLayout(MATCH_PARENT, MATCH_PARENT) не помог до конца. Обычная Activity —
    никакой из этих тонкостей floating-окна нет в принципе, экран гарантированно на весь
    физический размер устройства.

    Поля теперь не открывают системную клавиатуру — это выключается кодом,
    setShowSoftInputOnFocus(false) в RestrictionsActivity.onCreate (атрибут
    android:showSoftInputOnFocus в самой разметке не существует как публичный XML-атрибут, хоть
    метод и называется так же — AAPT ругается "attribute not found", если его тут написать), и
    дополнительно явным запретом на уровне самого окна (Window.setSoftInputMode). Ввод идёт
    через свою маленькую цифровую клавиатуру (1-9, ←/0/→, Стереть — тот же набор, что был в
    HTML-макете, .limits-keypad, но по 5 цифр в ряд, а не по 3 — высоты так требуется вдвое
    меньше, а по ширине места на альбомном экране достаточно), а ← → явно и однозначно
    переключают активное поле (оно подсвечивается синим) — порядок заранее известный и
    правильный, гадать не на что.

    Поля+клавиатура и список введённых ограничений — бок о бок, двумя колонками (как в самом
    HTML-макете, .limits-modal-body: display:flex), каждая в своём ScrollView с ЧЁТКО заданной
    высотой (layout_weight внутри вертикального LinearLayout между шапкой и кнопкой "Закрыть",
    а не wrap_content) — именно это заставляет ScrollView'ы по-настоящему прокручиваться, если
    что-то не поместилось.

    Список ограничений общий с MainActivity через RestrictionsStore (route/Restriction.kt) —
    простой общий объект в памяти, а не Intent-данные: он и так живёт только в памяти на время
    сессии в обоих случаях. MainActivity обновляет график (TrackProfileView.setRestrictions) в
    своём onResume(), когда возвращается с этого экрана.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#333333"
        android:padding="16dp"
        android:text="Ограничения"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Вес 1 — вся оставшаяся высота (между шапкой и кнопкой "Закрыть") ЧЁТКО задана, не
         wrap_content, поэтому ScrollView'ы в колонках ниже по-настоящему прокручиваются, если
         не помещаются (см. doc-комментарий выше). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:padding="16dp">

    <!-- Левая колонка: поля + своя клавиатура. -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="НАЧАЛО"
                android:textColor="#5AAADC"
                android:textSize="12sp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/restrictionStartKmInput"
                    style="@style/RestrictionDigitBox"
                    android:layout_width="64dp"
                    android:hint="км"
                    android:inputType="number"
                    android:maxLength="4" />

                <EditText
                    android:id="@+id/restrictionStartPkInput"
                    style="@style/RestrictionDigitBox"
                    android:layout_width="44dp"
                    android:layout_marginStart="8dp"
                    android:hint="пк"
                    android:inputType="number"
                    android:maxLength="2" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="КОНЕЦ (необязательно)"
                android:textColor="#5AAADC"
                android:textSize="12sp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/restrictionEndKmInput"
                    style="@style/RestrictionDigitBox"
                    android:layout_width="64dp"
                    android:hint="км"
                    android:inputType="number"
                    android:maxLength="4" />

                <EditText
                    android:id="@+id/restrictionEndPkInput"
                    style="@style/RestrictionDigitBox"
                    android:layout_width="44dp"
                    android:layout_marginStart="8dp"
                    android:hint="пк"
                    android:inputType="number"
                    android:maxLength="2" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="#222222" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Скорость — 2 цифры (машинист: "для скорости тоже 2"). -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Скорость"
                        android:textColor="#5AAADC"
                        android:textSize="11sp"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/restrictionSpeedInput"
                        style="@style/RestrictionDigitBox"
                        android:layout_width="44dp"
                        android:hint="—"
                        android:inputType="number"
                        android:maxLength="2" />

                </LinearLayout>

                <!-- Путь — 1 цифра (пусто = текущий путь). -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Путь"
                        android:textColor="#5AAADC"
                        android:textSize="11sp"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/restrictionPathInput"
                        style="@style/RestrictionDigitBox"
                        android:layout_width="36dp"
                        android:hint="—"
                        android:inputType="number"
                        android:maxLength="1" />

                </LinearLayout>

            </LinearLayout>

            <!-- Своя маленькая цифровая клавиатура (см. doc-комментарий класса выше) — пишет
                 в то поле, которое сейчас активно (подсвечено синим); ← → переключают активное
                 поле строго в правильном порядке: км→пк→км→пк→скорость→путь. По 5 цифр в ряд
                 (а не по 3, как раньше) — на низком альбомном экране важна каждая строка по
                 высоте, а по ширине места как раз много (экран широкий). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button android:id="@+id/restrictionKey1" style="@style/RestrictionKeypadButton" android:text="1" />
                    <Button android:id="@+id/restrictionKey2" style="@style/RestrictionKeypadButton" android:text="2" />
                    <Button android:id="@+id/restrictionKey3" style="@style/RestrictionKeypadButton" android:text="3" />
                    <Button android:id="@+id/restrictionKey4" style="@style/RestrictionKeypadButton" android:text="4" />
                    <Button android:id="@+id/restrictionKey5" style="@style/RestrictionKeypadButton" android:text="5" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button android:id="@+id/restrictionKey6" style="@style/RestrictionKeypadButton" android:text="6" />
                    <Button android:id="@+id/restrictionKey7" style="@style/RestrictionKeypadButton" android:text="7" />
                    <Button android:id="@+id/restrictionKey8" style="@style/RestrictionKeypadButton" android:text="8" />
                    <Button android:id="@+id/restrictionKey9" style="@style/RestrictionKeypadButton" android:text="9" />
                    <Button android:id="@+id/restrictionKey0" style="@style/RestrictionKeypadButton" android:text="0" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button android:id="@+id/restrictionKeyPrev" style="@style/RestrictionKeypadButton" android:text="←" />
                    <Button
                        android:id="@+id/restrictionBackspaceButton"
                        style="@style/RestrictionKeypadButton"
                        android:layout_weight="3"
                        android:text="Стереть" />
                    <Button android:id="@+id/restrictionKeyNext" style="@style/RestrictionKeypadButton" android:text="→" />
                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/restrictionErrorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#E05A5A"
                android:visibility="gone" />

            <Button
                android:id="@+id/restrictionAddButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Добавить" />

        </LinearLayout>

    </ScrollView>

    <!-- Правая колонка: список уже введённых ограничений. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:orientation="vertical"
        android:paddingStart="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="СПИСОК ОГРАНИЧЕНИЙ"
            android:textColor="#5AAADC"
            android:textSize="12sp"
            android:layout_marginBottom="6dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/restrictionRowsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </ScrollView>

    </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#333333"
        android:gravity="end"
        android:padding="12dp">

        <Button
            android:id="@+id/restrictionCloseButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:textColor="#B39DDB"
            android:textStyle="bold"
            android:text="ЗАКРЫТЬ" />

    </LinearLayout>

</LinearLayout>
