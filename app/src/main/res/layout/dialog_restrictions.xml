<?xml version="1.0" encoding="utf-8"?>
<!--
    "Ограничения" (ТЗ раздел 11, машинист называет их "предупреждения") — диалог поверх
    главного экрана, тем же способом, что и "Параметры" (dialog_train_params.xml): полей
    поменьше, но такая же обычная числовая клавиатура телефона вместо самодельной цифровой
    накладки из ТЗ-макета (см. README) — сознательное упрощение, тот же уровень сложности,
    что и у остальных диалогов реального экрана.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="НАЧАЛО"
            android:textColor="#5AAADC"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/restrictionStartKmInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:hint="км"
                android:inputType="number"
                android:maxLength="4"
                android:textColor="#FFFFFF"
                android:textColorHint="#777777" />

            <EditText
                android:id="@+id/restrictionStartPkInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:hint="пк"
                android:inputType="number"
                android:maxLength="2"
                android:textColor="#FFFFFF"
                android:textColorHint="#777777" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="КОНЕЦ (необязательно)"
            android:textColor="#5AAADC"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/restrictionEndKmInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:hint="км"
                android:inputType="number"
                android:maxLength="4"
                android:textColor="#FFFFFF"
                android:textColorHint="#777777" />

            <EditText
                android:id="@+id/restrictionEndPkInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:hint="пк"
                android:inputType="number"
                android:maxLength="2"
                android:textColor="#FFFFFF"
                android:textColorHint="#777777" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="#222222" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/restrictionSpeedInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Скорость, км/ч"
                android:inputType="number"
                android:maxLength="3"
                android:textColor="#FFFFFF"
                android:textColorHint="#777777" />

            <EditText
                android:id="@+id/restrictionPathInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:hint="Путь (пусто = текущий)"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="#FFFFFF"
                android:textColorHint="#777777" />

        </LinearLayout>

        <TextView
            android:id="@+id/restrictionErrorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#E05A5A"
            android:visibility="gone" />

        <Button
            android:id="@+id/restrictionAddButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Добавить" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="#222222" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="СПИСОК ОГРАНИЧЕНИЙ"
            android:textColor="#5AAADC"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/restrictionRowsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
