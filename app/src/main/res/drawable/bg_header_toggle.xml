<?xml version="1.0" encoding="utf-8"?>
<!-- Фон кнопок-переключателей в шапке (Чётное/Нечётное, Путь, К1, Меню) — тонкая белая
     рамка со скруглением, без заливки, как в HTML-макете (.hdr-toggle-btn). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="6dp" />
    <stroke android:width="1dp" android:color="#52FFFFFF" />
    <solid android:color="@android:color/transparent" />
</shape>
