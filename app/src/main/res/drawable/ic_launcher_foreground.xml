    <path
        android:fillColor="#A09FA4"
        android:pathData="M26,68 h11 v14 h-11 Z" />
    <path
        android:fillColor="#A09FA4"
        android:pathData="M43,56 h11 v26 h-11 Z" />
    <path
        android:fillColor="#A09FA4"
        android:pathData="M60,42 h11 v40 h-11 Z" />
    <path
        android:fillColor="#A09FA4"
        android:pathData="M77,28 h11 v54 h-11 Z" />

    <!-- Зелёная вертикальная линия — позиция поезда -->
    <path
        android:fillColor="#2CFF27"
        android:pathData="M57,20 h6 v66 h-6 Z" />

</vector>
