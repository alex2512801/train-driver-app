<?xml version="1.0" encoding="utf-8"?>
<!--
    Иконка приложения — мини-версия главного графика (ТЗ раздел 7): серые "ступени" скорости
    по возрастанию + зелёная вертикальная линия поезда поперёк них, те же самые цвета, что и
    в TrackProfileView (stepPaint rgb(160,159,164), trainMarkerPaint rgb(44,255,39)) — чтобы
    иконка на телефоне сразу узнавалась как эта программа, не случайный рисунок.
-->
