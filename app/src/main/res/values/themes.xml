<resources>
    <style name="Theme.TrainDriverApp" parent="Theme.MaterialComponents.DayNight.NoActionBar" />

    <!-- Шапка главного экрана (ТЗ раздел 7, HTML-макет "Ступени Хилока", .hdr-toggle-btn) —
         кнопка-переключатель с тонкой белой рамкой, без заливки. Размеры компактные —
         машинист попросил, чтобы вся шапка помещалась в ОДНУ строку без прокрутки вбок;
         всё равно не меньше обычного минимального размера тап-зоны (кликабельно). -->
    <style name="HeaderToggleButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:background">@drawable/bg_header_toggle</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Кнопка-иконка в шапке (⏱/📋/🌙) — без рамки и фона, эмодзи, тап-зона не меньше
         обычного минимального размера (40dp), но компактнее, чем раньше — см. комментарий
         у HeaderToggleButton выше. -->
    <style name="HeaderIconButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">40dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Тонкий вертикальный разделитель между блоками шапки (HTML-макет: border-left у
         .hdr-b). -->
    <style name="HeaderDivider">
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">26dp</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:background">#24FFFFFF</item>
    </style>

    <!-- Своя маленькая цифровая клавиатура в экране "Ограничения" (ТЗ раздел 11, HTML-макет
         .limits-keypad) — машинист попросил: системная занимала весь экран, не видно было, что
         вводишь. Одна кнопка на 1/5 ширины строки (5 в ряд), крупная — это теперь ОСНОВНОЙ
         способ ввода, не вспомогательный.
         parent="Widget.AppCompat.Button.Borderless" ОБЯЗАТЕЛЕН: под темой
         Theme.MaterialComponents обычный <Button> без явного родителя автоматически превращается
         в MaterialButton, у которой сверху свой полупрозрачный слой (surface tint/ripple) поверх
         фона и текста — именно из-за него машинист не мог разглядеть белые цифры на кнопках
         (видны были только тонкие, как будто полупрозрачные контуры). У кнопок HeaderToggleButton
         в шапке главного экрана эта же проблема уже была решена точно так же — см. этот стиль
         выше по файлу. -->
    <style name="RestrictionKeypadButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:background">@drawable/bg_header_toggle</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
    </style>

    <!-- Нижняя статусная строка (Vф/Уклон/V=/S=/Голова/Хвост) — каждое значение в своей
         рамке-"секторе", как кнопки в верхней шапке (HeaderToggleButton), а не одной сплошной
         строкой текста. Машинист: раньше всё прижималось к левому краю одним куском, а когда
         где-то стоял "?", всё остальное сразу съезжало влево вместе с ним — непонятно, где что.
         Ширина каждого сектора — через android:layout_weight на самом месте использования (не
         в стиле — у каждого поля разный запас под максимальное значение, см. doc-комментарий у
         statusBarRow в activity_main.xml), поэтому сектор всегда одной и той же ширины
         независимо от того, что в нём сейчас написано ("?" или настоящее число). -->
    <style name="StatusCell">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:background">@drawable/bg_header_toggle</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">13sp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- Поля в диалоге "Ограничения" — машинист попросил: км нужно 4 цифры, пк/скорость — 2,
         путь — 1, так что поля не должны тянуться на всю ширину строки "про запас", а быть
         ровно под своё число цифр, аккуратной рамкой-коробочкой (а не обычной подчёркнутой
         строкой). Ширину каждого поля задаём отдельно — см. restrictionXxxInput. -->
    <style name="RestrictionDigitBox">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:background">@drawable/bg_header_toggle</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textColorHint">#555555</item>
    </style>
</resources>
