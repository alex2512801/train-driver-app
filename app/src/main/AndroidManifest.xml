<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Уровень сигнала SIM-карты в шапке (ТЗ раздел 7, блок SIM) — без этого разрешения
         Android не отдаёт настоящую силу сигнала/тип сети. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- GpsForegroundService (машинист: взять из "Блокнота машиниста" foreground-сервис +
         постоянное уведомление + wake lock, чтобы GPS не останавливался в фоне). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Без этого разрешения (API 33+) постоянное уведомление сервиса не показывается вообще —
         запрашивается в MainActivity вместе с остальными (см. requestNotificationPermissionIfNeeded). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Диалог-подсказка про отключение батарейной оптимизации (BatteryOptimizationHelper). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.TrainDriverApp"
        android:supportsRtl="true">

        <!-- Стартовое меню (машинист, ТЗ раздел 12) — теперь первый экран при запуске
             приложения, а не сразу главный экран. См. doc-комментарий в MenuActivity.kt. -->
        <activity
            android:name=".MenuActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout" />

        <!-- "База данных" (ТЗ раздел 12, пункт меню) — обновление карт/скоростей/переездов и
             т.п. прямо с устройства, без пересборки приложения (см. DatabaseActivity.kt /
             DataOverrideStore.kt). -->
        <activity
            android:name=".DatabaseActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout" />

        <!-- "Ограничения" (ТЗ раздел 11) — отдельный полноэкранный экран, не диалог поверх
             MainActivity (см. doc-комментарий в RestrictionsActivity.kt). -->
        <activity
            android:name=".RestrictionsActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout" />

        <!-- "Параметры" (ТЗ раздел 5/12.2) — та же причина, что и у "Ограничений" (см.
             doc-комментарий в TrainParamsActivity.kt). -->
        <activity
            android:name=".TrainParamsActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout" />

        <!-- Меню из главного экрана (кнопка "Меню" в статусной строке MainActivity, на месте
             бывшей прямой кнопки "Параметры") — см. doc-комментарий в AppMenuActivity.kt. -->
        <activity
            android:name=".AppMenuActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout" />

        <!-- GpsForegroundService — см. doc-комментарий в GpsForegroundService.kt. -->
        <service
            android:name=".location.GpsForegroundService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>

</manifest>
